Subject: [PATCH 3/6] fix: don't fail output test if refresh rate is non-zero

---
 backend/wayland/output.c | 5 -----
 backend/x11/output.c     | 5 -----
 2 files changed, 10 deletions(-)

diff --git a/backend/wayland/output.c b/backend/wayland/output.c
index 66e0e894..4ef5a691 100644
--- a/backend/wayland/output.c
+++ b/backend/wayland/output.c
@@ -321,11 +321,6 @@ static bool output_test(struct wlr_output *wlr_output,
 
 	if (state->committed & WLR_OUTPUT_STATE_MODE) {
 		assert(state->mode_type == WLR_OUTPUT_STATE_MODE_CUSTOM);
-
-		if (state->custom_mode.refresh != 0) {
-			wlr_log(WLR_DEBUG, "Refresh rates are not supported");
-			return false;
-		}
 	}
 
 	if ((state->committed & WLR_OUTPUT_STATE_BUFFER) &&
diff --git a/backend/x11/output.c b/backend/x11/output.c
index 51a8459d..221a7304 100644
--- a/backend/x11/output.c
+++ b/backend/x11/output.c
@@ -159,11 +159,6 @@ static bool output_test(struct wlr_output *wlr_output,
 
 	if (state->committed & WLR_OUTPUT_STATE_MODE) {
 		assert(state->mode_type == WLR_OUTPUT_STATE_MODE_CUSTOM);
-
-		if (state->custom_mode.refresh != 0) {
-			wlr_log(WLR_DEBUG, "Refresh rates are not supported");
-			return false;
-		}
 	}
 
 	return true;
