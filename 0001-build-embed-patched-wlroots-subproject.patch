From af139bbe7d0bbc0079ca2a31031399f81203662a Mon Sep 17 00:00:00 2001
From: Xtr126 <k.gunetilleke@gmail.com>
Date: Mon, 12 Oct 2026 14:19:16 +0530
Subject: [PATCH 1/8] build: embed patched wlroots subproject

---
 .gitignore  | 1 +
 meson.build | 7 ++++++-
 2 files changed, 7 insertions(+), 1 deletion(-)
 create mode 100644 .gitignore

diff --git a/.gitignore b/.gitignore
new file mode 100644
index 0000000..4dbe29f
--- /dev/null
+++ b/.gitignore
@@ -0,0 +1 @@
+/.cache/
diff --git a/meson.build b/meson.build
index 586e999..66edb89 100644
--- a/meson.build
+++ b/meson.build
@@ -35,7 +35,12 @@ if is_freebsd
   )
 endif
 
-wlroots        = dependency('wlroots-0.20', fallback: ['wlroots', 'wlroots'])
+wlroots_proj = subproject(
+  'wlroots',
+  default_options: ['examples=false', 'xwayland=disabled'],
+)
+
+wlroots        = wlroots_proj.get_variable('wlroots')
 wayland_server = dependency('wayland-server')
 xkbcommon      = dependency('xkbcommon')
 math           = cc.find_library('m')
-- 
